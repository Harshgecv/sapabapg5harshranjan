
PROGRAM ZMP_LIPS_DELIVERY.

TABLES: LIPS.

CONTROLS: TC_LIPS TYPE TABLEVIEW USING SCREEN 0100.

DATA: GV_VBELN TYPE LIPS-VBELN.

DATA: BEGIN OF GS_LIPS,
        VBELN TYPE LIPS-VBELN,
        POSNR TYPE LIPS-POSNR,
        MATNR TYPE LIPS-MATNR,
        WERKS TYPE LIPS-WERKS,
        LGORT TYPE LIPS-LGORT,
        LFIMG TYPE LIPS-LFIMG,
        VRKME TYPE LIPS-VRKME,
        CHARG TYPE LIPS-CHARG,
      END OF GS_LIPS.

DATA: GT_LIPS LIKE STANDARD TABLE OF GS_LIPS.

DATA: BEGIN OF GS_VBELN,
        VBELN TYPE LIPS-VBELN,
      END OF GS_VBELN.

DATA: GT_VBELN LIKE STANDARD TABLE OF GS_VBELN.


MODULE STATUS_0100 OUTPUT.

  SET PF-STATUS 'MAIN'.

  DESCRIBE TABLE GT_LIPS LINES TC_LIPS-LINES.

ENDMODULE.


MODULE DISPLAY_LIPS OUTPUT.

ENDMODULE.


MODULE USER_COMMAND_0100 INPUT.

  CASE SY-UCOMM.

    WHEN 'FETCH'.

      CLEAR GT_LIPS.

      SELECT VBELN POSNR MATNR WERKS LGORT
             LFIMG VRKME CHARG
        FROM LIPS
        INTO TABLE GT_LIPS
        WHERE VBELN = GV_VBELN.

      DESCRIBE TABLE GT_LIPS LINES TC_LIPS-LINES.

      IF GT_LIPS IS INITIAL.
        MESSAGE 'No delivery items found' TYPE 'I'.
      ELSE.
        TC_LIPS-TOP_LINE = 1.
        MESSAGE 'Delivery items fetched successfully' TYPE 'S'.
      ENDIF.

    WHEN 'BACK'.

      LEAVE TO SCREEN 0.

    WHEN 'EXIT' OR 'CANCEL'.

      LEAVE PROGRAM.

  ENDCASE.

ENDMODULE.


MODULE F4_VBELN INPUT.

  CLEAR GT_VBELN.

  SELECT DISTINCT VBELN
    FROM LIPS
    INTO TABLE GT_VBELN.

  IF GT_VBELN IS INITIAL.
    MESSAGE 'No delivery numbers found' TYPE 'I'.
    RETURN.
  ENDIF.

  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
    EXPORTING
      RETFIELD    = 'VBELN'
      DYNPPROG    = SY-REPID
      DYNPNR      = SY-DYNNR
      DYNPROFIELD = 'GV_VBELN'
      VALUE_ORG   = 'S'
    TABLES
      VALUE_TAB   = GT_VBELN
    EXCEPTIONS
      PARAMETER_ERROR = 1
      NO_VALUES_FOUND = 2
      OTHERS          = 3.

ENDMODULE.
